# ── MongoDB ──────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=changeme_strong_password

# Full connection string (used by backend)
MONGO_URI=mongodb://admin:changeme_strong_password@mongo:27017/goairclass?authSource=admin

# ── Backend ───────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars

# ── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Admin seed ───────────────────────────────────────────
ADMIN_MOBILE=9999999999
ADMIN_NAME=Super Admin

# ── Email (Nodemailer) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ── SMS / OTP ─────────────────────────────────────────────
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=GOAIRCLS

# ── reCAPTCHA ─────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=your_recaptcha_secret
