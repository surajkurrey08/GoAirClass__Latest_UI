# ── MongoDB ──────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=changeme_strong_password

# Full connection string (used by backend) — Atlas or local mongo service
MONGO_URI=mongodb://admin:changeme_strong_password@mongo:27017/goairclass?authSource=admin

# ── Backend ───────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars

# ── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (Nodemailer) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ── App URL ───────────────────────────────────────────────
FRONTEND_URL=https://goairclass.com

# ── CRM Lead Sync ─────────────────────────────────────────
CRM_API_URL=https://billpay.business/api/leads/capture
CRM_API_KEY=your_crm_api_key
